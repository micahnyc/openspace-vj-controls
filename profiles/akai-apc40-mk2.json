{
  "profileVersion": 1,
  "name": "Akai APC40 mkII",
  "match": [
    "APC40 mkII",
    "APC40 mkII MIDI"
  ],
  "source": "https://cdn.inmusicbrands.com/akai/attachments/apc40II/APC40Mk2_Communications_Protocol_v1.2.pdf",
  "init": {
    "description": "Switch to Mode 2 (Alternate Ableton Live): device knobs not banked by track select, buttons momentary, all LEDs host-controlled. Requires Web MIDI sysex permission.",
    "sysex": "F0 47 7F 29 60 00 04 42 01 00 00 F7",
    "verify": "device ID 7F and version bytes"
  },
  "encoderModes": {
    "relative-signed-bit7": "0x00 no change; 0x01-0x3F = +1..+63; 0x40-0x7F = -64..-1"
  },
  "defaults": {
    "slider": "range",
    "knob": "beatInterval",
    "encoder": "beatInterval",
    "pad": "instant",
    "button": "instant"
  },
